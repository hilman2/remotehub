{
  "$id": "https://github.com/hilman2/remotehub/deploy/kratos/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "remotehub account",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-mail",
          "maxLength": 320,
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "totp": { "account_name": true }
            },
            "recovery": { "via": "email" }
          }
        },
        "name": {
          "type": "string",
          "title": "Name",
          "maxLength": 200
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
