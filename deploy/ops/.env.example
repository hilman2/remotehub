# Settings of this installation, read by compose.yml. init.sh copies this
# file to .env. Every setting: docs/configuration.md.

# The release to run. Upgrades: docs/install.md#upgrade.
REMOTEHUB_VERSION=0.1.0

# The address people open, behind the reverse proxy. Must be https.
REMOTEHUB_PUBLIC_URL=https://remotehub.example.com

# Port on 127.0.0.1 for the reverse proxy.
REMOTEHUB_PORT=8080

# Active Directory. The bind password goes into secrets/ldap_bind_password.
REMOTEHUB_LDAP_URL=ldaps://dc.example.com
REMOTEHUB_LDAP_BIND_DN=svc-remotehub@example.com
REMOTEHUB_LDAP_BASE_DN=DC=example,DC=com

# Groups that administer remotehub: names or SIDs, separated by commas.
REMOTEHUB_ADMIN_GROUPS=remotehub Admins

# Keyboard layout of RDP sessions for devices without their own.
REMOTEHUB_RDP_KEYBOARD_LAYOUT=en-us-qwerty
