# Settings of this installation, read by compose.yml. init.sh copies this
# file to .env. Every setting: docs/configuration.md.

# The release to run. Upgrades: docs/install.md#upgrade.
REMOTEHUB_VERSION=0.1.0

# The address people open, behind the reverse proxy. Must be https.
REMOTEHUB_PUBLIC_URL=https://remotehub.example.com
# Its host name alone, without https:// and port; passkeys belong to it.
REMOTEHUB_HOST=remotehub.example.com

# Port on 127.0.0.1 for a reverse proxy on this host.
REMOTEHUB_PORT=8080

# caddy: Caddy of this package serves remotehub on ports 80 and 443. Empty
# when a reverse proxy of your own does.
#COMPOSE_PROFILES=caddy

# Address range of the containers' network. guacd and the browser service
# cannot reach devices in it. Caddy's address must lie in it.
#REMOTEHUB_SUBNET=10.213.213.0/24
#REMOTEHUB_GATEWAY=10.213.213.1
#REMOTEHUB_CADDY_ADDRESS=10.213.213.2

# Keyboard layout of RDP sessions for devices without their own.
REMOTEHUB_RDP_KEYBOARD_LAYOUT=en-us-qwerty

# Web interfaces open at once, and the browser service's memory for them.
#REMOTEHUB_BROWSER_SESSIONS=8
#REMOTEHUB_BROWSER_MEMORY=3g
